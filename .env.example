# Demo mode defaults to true during development and false in production.
# Explicitly set true for a deployed capstone demo. Never use for real access control.
VITE_ENABLE_MOCK_AUTH=true
# Required in API mode. Supply your .NET API origin/base path; no URL is assumed.
VITE_API_BASE_URL=
# Business-domain mocks are independent of authentication. Production defaults off.
VITE_ENABLE_MOCK_SERVICES=true
