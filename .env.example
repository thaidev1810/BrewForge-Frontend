# Set true for local standalone mock mode; set false to connect to the real .NET backend.
VITE_ENABLE_MOCK_AUTH=false
# Required in API mode. In dev, /api/v1 is proxied by Vite to http://localhost:5113.
VITE_API_BASE_URL=/api/v1
# Business-domain mocks are independent of authentication. Production defaults off.
VITE_ENABLE_MOCK_SERVICES=false
