# Copy to .env.e2e.local (ignored). Never use production/shared DB credentials.
E2E_BASE_URL=http://127.0.0.1:5173
# Must match VITE_API_BASE_URL in the existing frontend environment; do not change .env.
E2E_API_BASE_URL=
# Set true only after confirming API uses an isolated disposable test database.
E2E_TEST_ENV_CONFIRMED=false
# Backend login uses username. EMAIL is an optional alias only when it is the real username.
E2E_ADMIN_USERNAME=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_RD_SPECIALIST_USERNAME=
E2E_RD_SPECIALIST_EMAIL=
E2E_RD_SPECIALIST_PASSWORD=
E2E_RD_MANAGER_USERNAME=
E2E_RD_MANAGER_EMAIL=
E2E_RD_MANAGER_PASSWORD=
E2E_TRAINER_USERNAME=
E2E_TRAINER_EMAIL=
E2E_TRAINER_PASSWORD=
E2E_TRAINING_MANAGER_USERNAME=
E2E_TRAINING_MANAGER_EMAIL=
E2E_TRAINING_MANAGER_PASSWORD=
E2E_TRAINEE_USERNAME=
E2E_TRAINEE_EMAIL=
E2E_TRAINEE_PASSWORD=
E2E_BRANCH_MANAGER_USERNAME=
E2E_BRANCH_MANAGER_EMAIL=
E2E_BRANCH_MANAGER_PASSWORD=
E2E_QUALITY_AUDITOR_USERNAME=
E2E_QUALITY_AUDITOR_EMAIL=
E2E_QUALITY_AUDITOR_PASSWORD=
